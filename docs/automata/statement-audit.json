  "review_scope": "Named public statements and their defining relations; dependency hashes record identity, not a claim that every dependency was audited.",
  "reviews": [
    {
      "id": "positive-exact-count",
      "source": "metatheory/Dregg2/Datalog/FixpointCert.lean",
      "statement": "Dregg2.Datalog.FixpointCert.verify_sound",
      "witness": "Dregg2.Datalog.FixpointCert.Reference.honest_verifies",
      "falsifier": "Dregg2.Datalog.FixpointCert.Reference.open_trace_separation",
      "witness_scope": "checker-premise",
      "scope": "Exact active-domain least fixpoint with set facts; count is by predicate, not arity. The hash is arbitrary; equal EDB roots yield equality or the deterministic MRootColl pair, not cryptographic collision resistance. The fixture hash is only an executable model."
    },
    {
      "id": "stratified-receipt",
      "source": "metatheory/Dregg2/Datalog/StratifiedCert.lean",
      "statement": "Dregg2.Datalog.StratifiedCert.verifyS_receipt",
      "witness": "Dregg2.Datalog.StratifiedCert.Reference.honest_count0_verifies",
      "falsifier": "Dregg2.Datalog.StratifiedCert.Reference.current_db_separation",
      "witness_scope": "checker-premise",
      "scope": "One database carries exactness, count and support. Negation uses each completed lower stratum. The statement names strata; independence from alternate stratifications is not proved. Dense range restriction is required only for the separate unrestricted-semantics transfer."
    },
    {
      "id": "join-refinement",
      "source": "metatheory/Dregg2/Datalog/JoinClosure.lean",
      "statement": "Dregg2.Datalog.JoinClosure.verifyJ_verifyS",
      "witness": "Dregg2.Automata.StatementAudit.join_accepts",
      "falsifier": "Dregg2.Datalog.JoinClosure.Reference.join_safety_separation",
      "witness_scope": "checker-premise",
      "scope": "Optimized checker refines enumeration; safety requires every variable index below the bound in a positive atom, including otherwise unused gaps. No reverse checker-completeness claim. Domain order/multiplicity congruence proves the positive witness without running opaque sort reductions."
    },
    {
      "id": "safe-unrestricted-receipt",
      "source": "metatheory/Dregg2/Datalog/SafeCoincidence.lean",
      "statement": "Dregg2.Datalog.SafeCoincidence.verifyJ_receipt",
      "witness": "Dregg2.Automata.StatementAudit.join_accepts",
      "falsifier": "Dregg2.Datalog.SafeCoincidence.Reference.unsafe_semantics_differ",
      "witness_scope": "checker-premise",
      "scope": "The join checker itself enforces dense safety; exact unrestricted semantics and supported-model claims share one database. The unsafe counterexample separates active-domain from unrestricted derivability, not two checker verdicts."
    },
    {
      "id": "exact-budget",
      "source": "metatheory/Dregg2/Datalog/Aggregates.lean",
      "statement": "Dregg2.Datalog.Aggregates.verifyBudget_sound",
      "witness": "Dregg2.Automata.StatementAudit.budget_accepts",
      "falsifier": "Dregg2.Automata.StatementAudit.budget_separation",
      "witness_scope": "checker-premise",
      "scope": "Signed mathematical integer sum over set facts; a missing argument contributes zero. No machine-word wraparound or field accumulation theorem. Positive certificate includes a refunded charge and total 9; weakened verifier trusts the final accumulator and accepts false total 5 under budget 8."
    },
    {
      "id": "dfa-content-binding",
      "source": "metatheory/Dregg2/Crypto/Dfa.lean",
      "statement": "Dregg2.Crypto.Dfa.dfa_bound_identifies_record_or_collides",
      "witness": "Dregg2.Crypto.Dfa.Reference.aab_accepts",
      "falsifier": "Dregg2.Crypto.Dfa.Reference.splice_fails_bound",
      "witness_scope": "relation-only",
      "scope": "Conditional on kernel extractability and acceptance. Collision names the accepted trace word and intended record. The aab witness inhabits DfaAccepts only: no concrete full DfaBoundVerifierKernel/extractability instance is supplied by this file. Do not advertise full premise inhabitation or a deployed cryptographic reduction."
    },
    {
      "id": "table-corpus-count",
      "source": "metatheory/Dregg2/Automata/TableRunSpec.lean",
      "statement": "Dregg2.Automata.TableRun.rejectCount_eq_zero_iff",
      "witness": "Dregg2.Automata.StatementAudit.table_accepts",
      "falsifier": "Dregg2.Automata.StatementAudit.table_omission_changes_count",
      "witness_scope": "relation-instance",
      "scope": "Exact count over the provided document list only. No commitment, arrival/provenance coverage, policy language correctness or table validation follows. The omitted-record counterexample uses a deliberately malformed total table to make this boundary cheap to check; it is not a compiler fixture."
    },
    {
      "id": "table-validation-boundary",
      "source": "metatheory/Dregg2/Automata/TableRun.lean",
      "statement": "Dregg2.Automata.TableRun.rejectCount_eq_zero_iff",
      "witness": "Dregg2.Automata.StatementAudit.table_accepts",
      "falsifier": "Dregg2.Automata.StatementAudit.table_validation_separation",
      "witness_scope": "relation-instance",
      "scope": "The runner is total using default state zero. A missing transition array can accept the empty word while wellFormed refuses the table; run/acceptance agreement must not be used as table validation."
    }
  ],
