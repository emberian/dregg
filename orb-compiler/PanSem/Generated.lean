theorem set_var_hol_eqn_1 {θ : Type}  (v : P3.Pan.mlstring) (value : P3.Pan.v) (s : P3.Pan.state θ) :
    P3.Pan.set_var v value s = { s with locals := (P3.Pan.FUPDATE (P3.Pan.state.locals s) (v, value)) } := by
  hol_eqn P3.Pan.set_var

theorem set_global_hol_eqn_1 {θ : Type}  (v : P3.Pan.mlstring) (value : P3.Pan.v) (s : P3.Pan.state θ) :
    P3.Pan.set_global v value s = { s with globals := (P3.Pan.FUPDATE (P3.Pan.state.globals s) (v, value)) } := by
  hol_eqn P3.Pan.set_global

theorem set_kvar_hol_eqn_1 {θ : Type}  (vk : P3.Pan.varkind) (v : P3.Pan.mlstring) (value : P3.Pan.v) (s : P3.Pan.state θ) :
    P3.Pan.set_kvar vk v value s = (match vk with
  | P3.Pan.varkind.Local => P3.Pan.set_var v value s
  | P3.Pan.varkind.Global => P3.Pan.set_global v value s) := by
  hol_eqn P3.Pan.set_kvar

theorem lookup_kvar_hol_eqn_1 {θ : Type}  (vk : P3.Pan.varkind) (v : P3.Pan.mlstring) (s : P3.Pan.state θ) :
    P3.Pan.lookup_kvar vk v s = (match vk with
  | P3.Pan.varkind.Local => ((P3.Pan.state.locals s) v)
  | P3.Pan.varkind.Global => ((P3.Pan.state.globals s) v)) := by
  hol_eqn P3.Pan.lookup_kvar

theorem is_valid_value_hol_eqn_1 {β : Type}  (s : P3.Pan.state β) (vk : P3.Pan.varkind) (v : P3.Pan.mlstring) (value : P3.Pan.v) :
    P3.Pan.is_valid_value s vk v value = (match P3.Pan.lookup_kvar vk v s with
  | (Option.none : Option P3.Pan.v) => False
  | (Option.some w) => ((P3.Pan.shape_of value) = (P3.Pan.shape_of w))) := by
  hol_eqn P3.Pan.is_valid_value

theorem res_var_hol_eqn_1 {β α : Type}  (lc : P3.Pan.FMap α β) (n : α) :
    P3.Pan.res_var lc (n, (Option.none : Option β)) = (P3.Pan.DOMSUB lc n) := by
  hol_eqn P3.Pan.res_var

theorem res_var_hol_eqn_2 {β α : Type}  (lc : P3.Pan.FMap α β) (n : α) (v : β) :
    P3.Pan.res_var lc (n, (Option.some v)) = (P3.Pan.FUPDATE lc (n, v)) := by
  hol_eqn P3.Pan.res_var

theorem empty_locals_hol_eqn_1 {θ : Type}  (s : P3.Pan.state θ) :
    P3.Pan.empty_locals s = { s with locals := (P3.Pan.FEMPTY : P3.Pan.FMap P3.Pan.mlstring P3.Pan.v) } := by
  hol_eqn P3.Pan.empty_locals

theorem dec_clock_hol_eqn_1 {θ : Type}  (s : P3.Pan.state θ) :
    P3.Pan.dec_clock s = { s with clock := ((P3.Pan.state.clock s) - 1) } := by
  hol_eqn P3.Pan.dec_clock

theorem fix_clock_hol_eqn_1 {γ α tv_e : Type}  (old_s : P3.Pan.state tv_e) (res : α) (new_s : P3.Pan.state γ) :
    P3.Pan.fix_clock old_s (res, new_s) = (res, { new_s with clock := if ((P3.Pan.state.clock old_s) < (P3.Pan.state.clock new_s)) then P3.Pan.state.clock old_s else P3.Pan.state.clock new_s }) := by
  hol_eqn P3.Pan.fix_clock

end P3.Pan
