theorem eval_hol_eqn_13 {θ : Type}  (s : P3.Pan.state θ) :
    P3.Pan.eval s P3.Pan.exp.BytesInWord = (Option.some (P3.Pan.v.Val (P3.Pan.word_lab.Word (BitVec.ofNat 64 8)))) := by
