/-
  P3 bridge: the theorem that makes "the proof is about a hand-copied Lean
  version of CakeML's Pancake semantics ... nothing links the two" false.

  `Pancake.PancakeSem` (Pancake/Sem.lean, transcribed by hand from panSem at
  CakeML ed31510b3) is compared with `P3.Pan.evaluate`, the MECHANICAL
  reflection of panSem's `evaluate_def` at the same CakeML revision
  (PanSem/GeneratedEval.lean, generated by DreggNet's p3-bridge exporter;
  every clause is a HOL4 kernel theorem re-proved in Lean, checkers 1-3 green).
  This file is the bridge lemma of the orb ladder: Pancake/LadderPanSem.lean
  states the ladder's rungs about `P3.Pan.evaluate` and proves them from the
  Sem.lean proofs through `evaluate_agree`.

  What is proved here, all axioms ⊆ {propext, Classical.choice, Quot.sound}
  (no `bv_decide`/`native_decide`: the bit-level lemmas are getLsbD proofs):

  * `sem_lean_assign_unscoped_disagrees`: the two semantics are NOT equal in
    general.  On `assign` to an unbound local, Sem.lean continues and panSem
    returns `Error` (panSem's `is_valid_value` check, dropped by Sem.lean as
    "vacuous").  A concrete program, both sides computed.
  * `eval_agree`: on the whole expression subset Sem.lean models, the
    reflected `eval` is Sem.lean's `eval` composed with `ValWord`.
  * `sem_lean_write_unmapped_disagrees`: Sem.lean's `writeByteArray` is not
    panSem's `write_bytearray` either: on an unmapped head byte panSem's
    `NONE => m` drops the writes already made to the tail; Sem.lean keeps
    them.  Unreachable from `ExtCall` (the array was just read, so every word
    is mapped), which is why `evaluate_agree` still covers ExtCall.
  * `evaluate_agree`: on every Sem.lean program that is SCOPED (each assign
    targets a local bound by an enclosing `dec` or by the initial state), the
    reflected `evaluate` and `PancakeSem` agree: related results and related
    final states, for the oracle induced by panSem's own `call_FFI`.
-/
import Pancake.Sem
import PanSem.GeneratedEval

set_option autoImplicit false
set_option maxHeartbeats 4000000
attribute [local instance] Classical.propDecidable

namespace P3.Agree
open P3.Pan

variable {θ : Type}

/-! ## 1. The embedding of Sem.lean's syntax into the reflected panLang -/

/-- Variable / FFI names: Sem.lean uses Lean `String`, panLang `mlstring`
(a byte list).  The embedding is the UTF-8 byte list, injective. -/
def nm (s : String) : mlstring := mlstring.implode s.toByteArray.data.toList

theorem nm_inj {a b : String} (h : nm a = nm b) : a = b := by
  simp only [nm, mlstring.implode.injEq] at h
  exact String.toByteArray_inj.mp (ByteArray.ext (Array.ext' h))

def liftBinop : Pancake.Binop → binop
  | .add => .Add
  | .and_ => .And
  | .sub => .Sub

def liftCmp : Pancake.Cmp → cmp
  | .less => .Less
  | .equal => .Equal
  | .notLess => .NotLess

def liftExp : Pancake.PancakeExp → exp
  | .const w => .Const w
  | .var n => .Var .Local (nm n)
  | .base => .BaseAddr
  | .op b l r => .Op (liftBinop b) [liftExp l, liftExp r]
  | .mul l r => .Panop .Mul [liftExp l, liftExp r]
  | .cmp c l r => .Cmp (liftCmp c) (liftExp l) (liftExp r)
  | .loadByte a => .LoadByte (liftExp a)
  | .loadWord a => .Load .One (liftExp a)

def liftProg : Pancake.PancakeProg → prog
  | .skip => .Skip
  | .dec v e c => .Dec (nm v) .One (liftExp e) (liftProg c)
  | .assign v e => .Assign .Local (nm v) (liftExp e)
  | .store d s => .Store (liftExp d) (liftExp s)
  | .extCall n a b c d => .ExtCall (nm n) (liftExp a) (liftExp b) (liftExp c) (liftExp d)
  | .seq a b => .Seq (liftProg a) (liftProg b)
  | .cond e a b => .If (liftExp e) (liftProg a) (liftProg b)
  | .while_ e c => .While (liftExp e) (liftProg c)
  | .ret e => .Return (liftExp e)
  | .storeByte d s => .StoreByte (liftExp d) (liftExp s)

/-- Word values. -/
abbrev VW (w : BitVec 64) : v := .Val (.Word w)

/-! ## 2. State and result relations -/

/-- A Sem.lean state and a reflected panSem state describe the same machine:
every field Sem.lean models agrees; the fields it omits (`globals`, `structs`,
`code`, `eshapes`, `sh_memaddrs`, `top_addr`) are unconstrained. -/
structure SR (ss : Pancake.PancakeState (ffi_state θ)) (hs : state θ) : Prop where
  locals   : ∀ k, hs.locals (nm k) = (ss.locals k).map VW
  memory   : hs.memory = fun a => word_lab.Word (ss.memory a)
  memaddrs : hs.memaddrs = fun a => ss.memaddrs a = true
  be       : hs.be = (ss.be = true)
  clock    : hs.clock = ss.clock
  ffi      : hs.ffi = ss.ffi
  base     : hs.base_addr = ss.baseAddr

/-- The FFI oracle Sem.lean is run with: panSem's own `call_FFI` on the
`ExtCall` name.  Sem.lean's `FinalEvent` is a lossy stand-in for
`final_event`; `ev` is ANY map between them (the theorem holds for all). -/
noncomputable def oracleOf (ev : final_event → Pancake.FinalEvent) :
    Pancake.Oracle (ffi_state θ) where
  call st name conf arr :=
    match call_FFI st (ffiname.ExtCall (nm name)) conf arr with
    | .FFI_return st' bs => .ret st' bs
    | .FFI_final e => .final (ev e)

/-- Results. -/
def RR (ev : final_event → Pancake.FinalEvent) : Option result → Option Pancake.Result → Prop
  | none, none => True
  | some .Error, some .error => True
  | some .TimeOut, some .timeout => True
  | some .Break, some .break_ => True
  | some .Continue, some .continue_ => True
  | some (.Return (.Val (.Word w))), some (.return_ w') => w = w'
  | some (.FinalFFI e), some (.finalFFI e') => ev e = e'
  | _, _ => False

/-! ## 3. The two semantics are not equal in general -/

/-- A concrete initial state: no locals bound. -/
def ss0 (f : ffi_state θ) : Pancake.PancakeState (ffi_state θ) :=
  { locals := fun _ => none, memory := fun _ => 0, memaddrs := fun _ => false,
    be := false, clock := 0, ffi := f, baseAddr := 0 }

noncomputable def hs0 (f : ffi_state θ) : state θ :=
  { locals := FEMPTY, globals := FEMPTY, structs := [], code := FEMPTY, eshapes := FEMPTY,
    memory := fun _ => .Word 0, memaddrs := fun _ => False, sh_memaddrs := fun _ => False,
    clock := 0, be := False, ffi := f, base_addr := 0, top_addr := 0 }

theorem ss0_hs0 (f : ffi_state θ) : SR (ss0 f) (hs0 f) where
  locals _ := rfl
  memory := rfl
  memaddrs := by funext a; simp [hs0, ss0]
  be := by simp [hs0, ss0]
  clock := rfl
  ffi := rfl
  base := rfl

/-- **The delta, as a theorem.**  Sem.lean says `x := 7` on an unbound `x`
succeeds; panSem (reflected) says `Error`.  So `PancakeSem` is NOT a faithful
transcription of `evaluate` on all programs: the agreement theorem below
needs the scoping hypothesis, and this is why. -/
theorem sem_lean_assign_unscoped_disagrees (ev : final_event → Pancake.FinalEvent)
    (f : ffi_state θ) :
    (Pancake.PancakeSem (oracleOf ev) (.assign "x" (.const 7)) (ss0 f)).1 = none ∧
    (evaluate (liftProg (.assign "x" (.const 7)), hs0 f)).1 = some .Error := by
  constructor
  · simp [Pancake.PancakeSem, Pancake.eval]
  · rw [liftProg, evaluate_hol_eqn_3]
    simp [liftExp, eval_hol_eqn_1, is_valid_value, lookup_kvar, hs0, FEMPTY]

/-! ## 4. Word and memory helper agreement -/


theorem byte_index_agree (a : BitVec 64) (be : Bool) :
    byte_index a (be = true) = Pancake.byteIndex a be := by
  cases be <;> simp [byte_index, Pancake.byteIndex]

theorem get_byte_agree (a w : BitVec 64) (be : Bool) :
    get_byte a w (be = true) = Pancake.getByte a w be := by
  simp only [get_byte, Pancake.getByte, byte_index_agree]

/-- `word_slice h l` as a BitVec expression, for `l ≤ h < 64`. -/
theorem word_slice_eq (h l : Nat) (w : BitVec 64) (hl : l ≤ h) (hh : h < 64) :
    word_slice h l w = (((w >>> l).setWidth (h + 1 - l)).setWidth 64) <<< l := by
  apply BitVec.eq_of_toNat_eq
  simp only [word_slice, BitVec.toNat_ofNat, BitVec.toNat_shiftLeft, BitVec.toNat_setWidth,
    BitVec.toNat_ushiftRight]
  have hlt : w.toNat >>> l % 2 ^ (h + 1 - l) < 2 ^ 64 :=
    Nat.lt_of_lt_of_le (Nat.mod_lt _ (Nat.two_pow_pos _)) (Nat.pow_le_pow_right (by omega) (by omega))
  rw [Nat.mod_eq_of_lt hlt]

theorem and_ones (b : BitVec 64) : b &&& 18446744073709551615#64 = b := by
  apply BitVec.eq_of_getLsbD_eq; intro i hi
  have h7 : (18446744073709551615 : Nat) = 2 ^ 64 - 1 := rfl
  simp only [BitVec.getLsbD_and, BitVec.getLsbD_ofNat, h7, Nat.testBit_two_pow_sub_one, hi,
    decide_true, Bool.and_true]

/-- Bit `i` of Sem.lean's mask `(1 <<< h) - 1` is `i < h`, for `h ≤ 64`. -/
theorem mask_bit (h i : Nat) (hh : h ≤ 64) :
    ((1#64 <<< h) - 1#64).getLsbD i = decide (i < h) := by
  have ht : ((1#64 <<< h) - 1#64).toNat = 2 ^ h - 1 := by
    rw [BitVec.toNat_sub, BitVec.toNat_shiftLeft]
    simp only [BitVec.toNat_ofNat]
    rcases Nat.lt_or_ge h 64 with h' | h'
    · have : 2 ^ h < 2 ^ 64 := Nat.pow_lt_pow_right (by omega) h'
      have hp : 0 < 2 ^ h := Nat.two_pow_pos h
      rw [Nat.one_shiftLeft, Nat.mod_eq_of_lt this]
      omega
    · have : h = 64 := by omega
      subst this; decide
  simp only [BitVec.getLsbD, ht, Nat.testBit_two_pow_sub_one]

theorem byte_align_agree (w : BitVec 64) : byte_align w = Pancake.byteAlign w := by
  simp only [byte_align, align, Pancake.byteAlign]
  apply BitVec.eq_of_getLsbD_eq; intro i hi
  have h7 : (7#64 : BitVec 64).getLsbD i = decide (i < 3) := by
    rw [show (7#64 : BitVec 64) = BitVec.ofNat 64 (2 ^ 3 - 1) from rfl, BitVec.getLsbD_ofNat,
      Nat.testBit_two_pow_sub_one]
    simp [hi]
  have hg : w.getLsbD i = w.toNat.testBit i := rfl
  simp only [word_slice, BitVec.getLsbD_and, BitVec.getLsbD_not, BitVec.getLsbD_ofNat, hi,
    Nat.testBit_shiftLeft, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, decide_true,
    Bool.true_and]
  by_cases h3 : 3 ≤ i
  · have e1 : i - 3 < 63 + 1 - 3 := by omega
    have e2 : ¬ i < 3 := by omega
    have e3 : 3 + (i - 3) = i := by omega
    simp [h3, e1, e2, e3, hg, h7]
  · have e2 : i < 3 := by omega
    simp [h3, e2, h7]

/-- panSem's `word_slice_alt` (bits `l ≤ i < h`) is Sem.lean's mask form. -/
theorem word_slice_alt_agree (h l : Nat) (w : BitVec 64) (hl : l ≤ h) (hh : h ≤ 64) :
    word_slice_alt h l w = Pancake.wordSliceAlt h l w := by
  apply BitVec.eq_of_getLsbD_eq; intro i hi
  simp only [Pancake.wordSliceAlt, BitVec.getLsbD_and, BitVec.getLsbD_not, mask_bit h i hh,
    mask_bit l i (by omega), hi, word_slice_alt, BitVec.getLsbD_ofNat, Nat.testBit_shiftLeft,
    Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, decide_true, Bool.true_and]
  have hg : w.getLsbD i = w.toNat.testBit i := rfl
  by_cases h1 : l ≤ i <;> by_cases h2 : i < h
  · have e1 : i - l < h - l := by omega
    have e2 : ¬ i < l := by omega
    simp [h1, h2, e1, e2, hg]
  · have e1 : ¬ i - l < h - l := by omega
    simp [h1, h2, e1]
  · have e2 : i < l := by omega
    simp [h1, h2, e2]
  · have e2 : i < l := by omega
    simp [h1, h2, e2]

theorem byteIndex_le (a : BitVec 64) (be : Bool) : Pancake.byteIndex a be ≤ 56 := by
  simp only [Pancake.byteIndex]
  have : a.toNat % 8 < 8 := Nat.mod_lt _ (by omega)
  split <;> omega

theorem set_byte_agree (a w : BitVec 64) (b : BitVec 8) (be : Bool) :
    set_byte a b w (be = true) = Pancake.setByte a b w be := by
  have hb : byte_index a (be = true) = Pancake.byteIndex a be := by
    cases be <;> simp [byte_index, Pancake.byteIndex]
  have hle := byteIndex_le a be
  simp only [set_byte, Pancake.setByte, hb]
  rw [word_slice_alt_agree _ _ _ (by omega) (by omega),
    word_slice_alt_agree _ _ _ (by omega) (by omega), BitVec.or_assoc]

theorem mem_load_byte_agree (m : BitVec 64 → BitVec 64) (dm : BitVec 64 → Bool) (be : Bool)
    (w : BitVec 64) :
    mem_load_byte (fun a => word_lab.Word (m a)) (fun a => dm a = true) (be = true) w =
      Pancake.memLoadByte m dm be w := by
  simp only [mem_load_byte, Pancake.memLoadByte, byte_align_agree, get_byte_agree]

/-! ## 5. Expressions -/

theorem eval_agree (ss : Pancake.PancakeState (ffi_state θ)) (hs : state θ) (h : SR ss hs) :
    ∀ e, eval hs (liftExp e) = (Pancake.eval ss e).map VW := by
  intro e
  induction e with
  | const w => simp [liftExp, eval_hol_eqn_1, Pancake.eval]
  | var n => simp [liftExp, eval_hol_eqn_2, Pancake.eval, h.locals]
  | base => simp [liftExp, eval_hol_eqn_11, Pancake.eval, h.base]
  | op b l r ihl ihr =>
    simp only [liftExp, eval_hol_eqn_7, List.mapM_cons, List.mapM_nil, ihl, ihr, Pancake.eval]
    cases hl : Pancake.eval ss l <;> cases hr : Pancake.eval ss r <;>
      simp [EVERY] <;> cases b <;> simp [liftBinop, word_op, and_ones]
  | mul l r ihl ihr =>
    simp only [liftExp, eval_hol_eqn_8, List.mapM_cons, List.mapM_nil, ihl, ihr, Pancake.eval]
    cases hl : Pancake.eval ss l <;> cases hr : Pancake.eval ss r <;> simp [EVERY, pan_op]
  | cmp c l r ihl ihr =>
    simp only [liftExp, eval_hol_eqn_9, ihl, ihr]
    cases c <;> simp only [Pancake.eval] <;>
      cases hl : Pancake.eval ss l <;> cases hr : Pancake.eval ss r <;>
      simp [liftCmp, word_cmp, Pancake.signedLt] <;> split <;> simp_all
  | loadByte a ih =>
    simp only [liftExp, eval_hol_eqn_6, ih, Pancake.eval]
    cases ha : Pancake.eval ss a <;> simp [h.memory, h.memaddrs, h.be, mem_load_byte_agree]
    cases Pancake.memLoadByte ss.memory ss.memaddrs ss.be _ <;> simp
  | loadWord a ih =>
    simp only [liftExp, eval_hol_eqn_5, ih, Pancake.eval, is_wf_shape]
    cases ha : Pancake.eval ss a <;> simp [mem_load, h.memory, h.memaddrs]


/-! ## 6. Memory writes and reads -/

/-- Sem.lean's memory, seen as panSem's. -/
def liftMem (m : BitVec 64 → BitVec 64) : BitVec 64 → word_lab := fun a => .Word (m a)
def liftDom (dm : BitVec 64 → Bool) : BitVec 64 → Prop := fun a => dm a = true

theorem mem_store_byte_agree (m : BitVec 64 → BitVec 64) (dm : BitVec 64 → Bool) (be : Bool)
    (w : BitVec 64) (b : BitVec 8) :
    mem_store_byte (liftMem m) (liftDom dm) (be = true) w b =
      (Pancake.memStoreByte m dm be w b).map liftMem := by
  simp only [mem_store_byte, Pancake.memStoreByte, liftMem, liftDom, byte_align_agree,
    set_byte_agree]
  split <;> simp only [Option.map_some, Option.map_none, Option.some.injEq]
  funext k
  simp only [UPDATE, liftMem]
  by_cases hk : k = Pancake.byteAlign w
  · subst hk; simp
  · simp [Ne.symm hk, hk]

theorem read_agree (m : BitVec 64 → BitVec 64) (dm : BitVec 64 → Bool) (be : Bool) :
    ∀ n a, read_bytearray a n (mem_load_byte (liftMem m) (liftDom dm) (be = true)) =
      Pancake.readByteArray m dm be a n := by
  intro n
  induction n with
  | zero => intro a; simp [read_bytearray, Pancake.readByteArray]
  | succ n ih =>
    intro a
    have h1 : a + BitVec.ofNat 64 1 = a + 1 := rfl
    have hl : mem_load_byte (liftMem m) (liftDom dm) (be = true) a = Pancake.memLoadByte m dm be a :=
      mem_load_byte_agree m dm be a
    rw [read_bytearray, Pancake.readByteArray, h1, hl, ih (a + 1)]
    cases Pancake.memLoadByte m dm be a <;> cases Pancake.readByteArray m dm be (a + 1) n <;> rfl

theorem ofNat_succ (a : BitVec 64) (i : Nat) :
    a + BitVec.ofNat 64 (i + 1) = a + 1 + BitVec.ofNat 64 i := by
  bv_omega

/-- A successful read of `n` bytes from `a` returns `n` bytes, all from mapped words. -/
theorem read_some (m : BitVec 64 → BitVec 64) (dm : BitVec 64 → Bool) (be : Bool) :
    ∀ n a l, Pancake.readByteArray m dm be a n = some l →
      l.length = n ∧ ∀ i < n, dm (Pancake.byteAlign (a + BitVec.ofNat 64 i)) = true := by
  intro n
  induction n with
  | zero => intro a l h; simp [Pancake.readByteArray] at h; subst h; simp
  | succ n ih =>
    intro a l h
    by_cases hd : dm (Pancake.byteAlign a) = true
    · simp only [Pancake.readByteArray, Pancake.memLoadByte, hd, if_true] at h
      split at h
      · simp at h
      · rename_i bs hbs
        simp only [Option.some.injEq] at h
        subst h
        obtain ⟨hl, hi⟩ := ih _ bs hbs
        refine ⟨by simp [hl], fun i hi' => ?_⟩
        cases i with
        | zero => simpa using hd
        | succ i =>
          have := hi i (by omega)
          rw [ofNat_succ]
          exact this
    · simp [Pancake.readByteArray, Pancake.memLoadByte, hd] at h

/-- Writing bytes back, when every target word is mapped: Sem.lean's
`writeByteArray` and panSem's `write_bytearray` agree.  (They DISAGREE in
general: on an unmapped head byte panSem's `NONE => m` discards the writes
already made to the tail, Sem.lean's `none => m'` keeps them; see
`sem_lean_write_unmapped_disagrees`.  On the ExtCall path the array was just
read successfully, so every word is mapped.) -/
theorem write_agree (dm : BitVec 64 → Bool) (be : Bool) :
    ∀ (bs : List (BitVec 8)) (a : BitVec 64) (m : BitVec 64 → BitVec 64),
      (∀ i < bs.length, dm (Pancake.byteAlign (a + BitVec.ofNat 64 i)) = true) →
      write_bytearray a bs (liftMem m) (liftDom dm) (be = true) =
        liftMem (Pancake.writeByteArray dm be a bs m) := by
  intro bs
  induction bs with
  | nil => intro a m _; simp [write_bytearray, Pancake.writeByteArray]
  | cons b bs ih =>
    intro a m hd
    have htail : ∀ i < bs.length, dm (Pancake.byteAlign (a + 1 + BitVec.ofNat 64 i)) = true :=
      fun i hi => by rw [← ofNat_succ]; exact hd (i + 1) (by simp; omega)
    have hhead : dm (Pancake.byteAlign a) = true := by simpa using hd 0 (by simp)
    have h1 : a + BitVec.ofNat 64 1 = a + 1 := rfl
    simp only [write_bytearray, Pancake.writeByteArray, h1, ih (a + 1) m htail,
      mem_store_byte_agree]
    simp [Pancake.memStoreByte, hhead]

/-- The second transcription delta, as a theorem: an unmapped head byte. -/
theorem sem_lean_write_unmapped_disagrees :
    let dm : BitVec 64 → Bool := fun a => a = 8
    write_bytearray 7 [0xAA, 0xBB] (liftMem (fun _ => 0)) (liftDom dm) False 8 ≠
      liftMem (Pancake.writeByteArray dm false 7 [0xAA, 0xBB] (fun _ => 0)) 8 := by
  simp [write_bytearray, mem_store_byte, Pancake.writeByteArray, Pancake.memStoreByte,
    liftMem, liftDom, byte_align_agree, Pancake.byteAlign, UPDATE]
  decide

/-! ## 7. Programs -/

/-- Every `assign` targets a local bound by an enclosing `dec` or listed in `Γ`. -/
def Scoped : List String → Pancake.PancakeProg → Prop
  | _, .skip => True
  | Γ, .dec v _ c => Scoped (v :: Γ) c
  | Γ, .assign v _ => v ∈ Γ
  | _, .store _ _ => True
  | _, .extCall _ _ _ _ _ => True
  | Γ, .seq a b => Scoped Γ a ∧ Scoped Γ b
  | Γ, .cond _ a b => Scoped Γ a ∧ Scoped Γ b
  | Γ, .while_ _ c => Scoped Γ c
  | _, .ret _ => True
  | _, .storeByte _ _ => True

/-- The locals in `Γ` are bound in the Sem.lean state. -/
def Bound (Γ : List String) (ss : Pancake.PancakeState (ffi_state θ)) : Prop :=
  ∀ k ∈ Γ, ss.locals k ≠ none

/-- Results after which execution may continue. -/
def Live : Option Pancake.Result → Prop
  | none => True
  | some .continue_ => True
  | some .break_ => True
  | _ => False

theorem RR_none {ev : final_event → Pancake.FinalEvent} {a : Option result} {b : Option Pancake.Result}
    (h : RR ev a b) : a = none ↔ b = none := by
  cases a with
  | none => cases b <;> simp_all [RR]
  | some x => cases b with
    | none => cases x <;> simp_all [RR]
    | some y => simp

theorem SR_fix_clock {ss : Pancake.PancakeState (ffi_state θ)} {hs : state θ} (h : SR ss hs)
    {r : Option Pancake.Result × Pancake.PancakeState (ffi_state θ)}
    {q : Option result × state θ} (hq : SR r.2 q.2) :
    SR (Pancake.clampClock ss.clock r).2 (fix_clock hs q).2 := by
  obtain ⟨q1, q2⟩ := q
  obtain ⟨r1, r2⟩ := r
  constructor
  all_goals simp only [Pancake.clampClock, fix_clock]
  · exact hq.locals
  · exact hq.memory
  · exact hq.memaddrs
  · exact hq.be
  · have hc := hq.clock
    dsimp only at hc ⊢
    rw [h.clock, hc]; split <;> omega
  · exact hq.ffi
  · exact hq.base

theorem SR_dec_clock {ss : Pancake.PancakeState (ffi_state θ)} {hs : state θ} (h : SR ss hs) :
    SR (Pancake.decClock ss) (dec_clock hs) where
  locals := h.locals
  memory := h.memory
  memaddrs := h.memaddrs
  be := h.be
  clock := by simp [dec_clock, Pancake.decClock, h.clock]
  ffi := h.ffi
  base := h.base

theorem SR_empty {ss : Pancake.PancakeState (ffi_state θ)} {hs : state θ} (h : SR ss hs) :
    SR (Pancake.emptyLocals ss) (empty_locals hs) where
  locals _ := by simp [empty_locals, Pancake.emptyLocals, FEMPTY]
  memory := h.memory
  memaddrs := h.memaddrs
  be := h.be
  clock := h.clock
  ffi := h.ffi
  base := h.base

theorem SR_setLocal {ss : Pancake.PancakeState (ffi_state θ)} {hs : state θ} (h : SR ss hs)
    (x : String) (w : BitVec 64) :
    SR { ss with locals := Pancake.setLocal ss.locals x w }
       { hs with locals := FUPDATE hs.locals (nm x, VW w) } where
  locals k := by
    simp only [FUPDATE, Pancake.setLocal]
    by_cases hk : k = x
    · subst hk; simp
    · have : nm k ≠ nm x := fun e => hk (nm_inj e)
      simp [hk, this, h.locals]
  memory := h.memory
  memaddrs := h.memaddrs
  be := h.be
  clock := h.clock
  ffi := h.ffi
  base := h.base

theorem call_FFI_length (st : ffi_state θ) (n : ffiname) (conf bytes : List (BitVec 8))
    (st' : ffi_state θ) (bs : List (BitVec 8)) (h : call_FFI st n conf bytes = .FFI_return st' bs) :
    bs.length = bytes.length := by
  simp only [call_FFI] at h
  split at h
  · split at h
    · split at h
      · simp only [ffi_result.FFI_return.injEq] at h; obtain ⟨_, rfl⟩ := h; assumption
      · simp at h
    · simp at h
  · simp only [ffi_result.FFI_return.injEq] at h; obtain ⟨_, rfl⟩ := h; rfl

/-- **The agreement theorem.**  For every scoped Sem.lean program, every pair
of related states, and every map `ev` of final events: the reflected panSem
`evaluate` and Sem.lean's `PancakeSem` (run with the oracle induced by
panSem's `call_FFI`) return related results and related states, and a live
result leaves the scope bound. -/
theorem evaluate_agree (ev : final_event → Pancake.FinalEvent) :
    ∀ (k : Nat) (p : Pancake.PancakeProg) (Γ : List String)
      (ss : Pancake.PancakeState (ffi_state θ)) (hs : state θ),
      ss.clock ≤ k → Scoped Γ p → Bound Γ ss → SR ss hs →
      RR ev (evaluate (liftProg p, hs)).1 (Pancake.PancakeSem (oracleOf ev) p ss).1 ∧
      SR (Pancake.PancakeSem (oracleOf ev) p ss).2 (evaluate (liftProg p, hs)).2 ∧
      (Live (Pancake.PancakeSem (oracleOf ev) p ss).1 →
        Bound Γ (Pancake.PancakeSem (oracleOf ev) p ss).2) := by
  intro k
  refine Nat.strongRecOn k ?_
  intro k ihk p
  induction p with
  | skip =>
    intro Γ ss hs _ _ hb h
    rw [liftProg, evaluate_hol_eqn_1, Pancake.PancakeSem]
    exact ⟨trivial, h, fun _ => hb⟩
  | dec x e c ih =>
    intro Γ ss hs hk hsc hb h
    rw [liftProg, evaluate_hol_eqn_2, Pancake.PancakeSem, eval_agree ss hs h]
    cases he : Pancake.eval ss e with
    | none => exact ⟨trivial, h, fun hl => absurd hl id⟩
    | some w =>
      have hsh : (shape.One = shape_of (VW w)) = True := by simp [shape_of]
      simp only [Option.map_some, hsh, if_true]
      obtain ⟨hr, hs', hl⟩ := ih (x :: Γ) { ss with locals := Pancake.setLocal ss.locals x w }
        { hs with locals := FUPDATE hs.locals (nm x, VW w) } hk hsc
        (fun k hk' => by
          simp only [List.mem_cons] at hk'
          simp only [Pancake.setLocal]
          by_cases hkx : k = x
          · simp [hkx]
          · simp only [hkx, if_false]; exact hb k (hk'.resolve_left hkx))
        (SR_setLocal h x w)
      refine ⟨hr, ?_, ?_⟩
      · constructor
        · intro j
          simp only [res_var, Pancake.resVar]
          rw [h.locals x]
          by_cases hj : j = x
          · subst hj
            cases ss.locals j <;> simp [res_var, DOMSUB, FUPDATE]
          · have hne : nm j ≠ nm x := fun e => hj (nm_inj e)
            cases hx : ss.locals x <;> simp [res_var, DOMSUB, FUPDATE, hne, hj, hs'.locals j]
        · exact hs'.memory
        · exact hs'.memaddrs
        · exact hs'.be
        · exact hs'.clock
        · exact hs'.ffi
        · exact hs'.base
      · intro hlive j hj
        simp only [Pancake.resVar]
        by_cases hjx : j = x
        · subst hjx; simp only [if_true]; exact hb j hj
        · simp only [hjx, if_false]
          exact hl hlive j (List.mem_cons_of_mem _ hj)
  | assign x e =>
    intro Γ ss hs _ hsc hb h
    rw [liftProg, evaluate_hol_eqn_3, Pancake.PancakeSem, eval_agree ss hs h]
    cases he : Pancake.eval ss e with
    | none => exact ⟨trivial, h, fun hl => absurd hl id⟩
    | some w =>
      obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.mp (hb x hsc)
      have hv : is_valid_value hs varkind.Local (nm x) (VW w) := by
        simp [is_valid_value, lookup_kvar, h.locals, hy, shape_of]
      simp only [Option.map_some, hv, if_true, set_kvar, set_var]
      refine ⟨trivial, SR_setLocal h x w, fun _ j hj => ?_⟩
      simp only [Pancake.setLocal]
      split
      · simp
      · exact hb j hj
  | store d src =>
    intro Γ ss hs _ _ hb h
    rw [liftProg, evaluate_hol_eqn_4, Pancake.PancakeSem, eval_agree ss hs h, eval_agree ss hs h]
    cases hd : Pancake.eval ss d <;> cases hv : Pancake.eval ss src
    all_goals try exact ⟨trivial, h, fun hl => absurd hl id⟩
    rename_i a w
    simp only [Option.map_some, flatten, mem_stores, mem_store, Pancake.memStoreWord, h.memaddrs]
    by_cases hdm : ss.memaddrs a = true
    · simp only [hdm, if_true]
      refine ⟨trivial, ⟨h.locals, ?_, by simp [h.memaddrs], h.be, h.clock, h.ffi, h.base⟩, fun _ => hb⟩
      funext c
      simp only [UPDATE, h.memory]
      by_cases hc : c = a
      · subst hc; simp
      · simp [hc, Ne.symm hc]
    · simp only [hdm]
      exact ⟨trivial, h, fun hl => absurd hl id⟩
  | extCall n cp cl ap al =>
    intro Γ ss hs _ _ hb h
    rw [liftProg, evaluate_hol_eqn_14, Pancake.PancakeSem]
    simp only [eval_agree ss hs h]
    cases h1 : Pancake.eval ss cp <;> cases h2 : Pancake.eval ss cl <;>
      cases h3 : Pancake.eval ss ap <;> cases h4 : Pancake.eval ss al
    all_goals try exact ⟨trivial, h, fun hl => absurd hl id⟩
    rename_i a1 a2 a3 a4
    simp only [Option.map_some, h.memory, h.memaddrs, h.be]
    have r1 := read_agree ss.memory ss.memaddrs ss.be a2.toNat a1
    have r2 := read_agree ss.memory ss.memaddrs ss.be a4.toNat a3
    unfold liftMem liftDom at r1 r2
    rw [r1, r2]
    cases hr1 : Pancake.readByteArray ss.memory ss.memaddrs ss.be a1 a2.toNat <;>
      cases hr2 : Pancake.readByteArray ss.memory ss.memaddrs ss.be a3 a4.toNat
    all_goals try exact ⟨trivial, h, fun hl => absurd hl id⟩
    rename_i conf arr
    simp only [oracleOf, h.ffi]
    cases hc : call_FFI ss.ffi (ffiname.ExtCall (nm n)) conf arr with
    | FFI_final e => exact ⟨rfl, SR_empty h, fun hl => absurd hl id⟩
    | FFI_return st' bs =>
      have hlen := call_FFI_length _ _ _ _ _ _ hc
      obtain ⟨harr, hdom⟩ := read_some ss.memory ss.memaddrs ss.be _ _ _ hr2
      have hw := write_agree ss.memaddrs ss.be bs a3 ss.memory
        (fun i hi => hdom i (by omega))
      dsimp only
      refine ⟨trivial, ⟨h.locals, ?_, rfl, rfl, h.clock, rfl, h.base⟩, fun _ => hb⟩
      unfold liftMem liftDom at hw
      exact hw
  | seq c1 c2 ih1 ih2 =>
    intro Γ ss hs hk hsc hb h
    rw [liftProg, evaluate_hol_eqn_6, Pancake.PancakeSem]
    obtain ⟨hr, hs1, hl1⟩ := ih1 Γ ss hs hk hsc.1 hb h
    have hfc := SR_fix_clock h hs1
    have hrn := RR_none hr
    simp only
    generalize hq : evaluate (liftProg c1, hs) = q at hr hs1 hfc hrn
    generalize hrr : Pancake.PancakeSem (oracleOf ev) c1 ss = r at hr hs1 hl1 hfc hrn
    obtain ⟨q1, q2⟩ := q
    obtain ⟨r1, r2⟩ := r
    simp only [fix_clock, Pancake.clampClock] at hfc ⊢
    cases r1 with
    | none =>
      have : q1 = none := hrn.mpr rfl
      subst this
      simp only [if_true]
      have hk2 : (Pancake.clampClock ss.clock (none, r2)).2.clock ≤ k := by
        simp [Pancake.clampClock]; omega
      exact ih2 Γ _ _ hk2 hsc.2 (hl1 trivial) hfc
    | some x =>
      have : q1 ≠ none := fun e => by have := hrn.mp e; simp at this
      simp only [this, if_false]
      exact ⟨hr, hfc, fun hlive => hl1 hlive⟩
  | cond e c1 c2 ih1 ih2 =>
    intro Γ ss hs hk hsc hb h
    rw [liftProg, evaluate_hol_eqn_7, Pancake.PancakeSem, eval_agree ss hs h]
    cases he : Pancake.eval ss e with
    | none => exact ⟨trivial, h, fun hl => absurd hl id⟩
    | some w =>
      have hz : (0#64 : BitVec 64) = 0 := rfl
      simp only [Option.map_some, hz]
      by_cases hw : w = 0
      · simp only [hw, ne_eq, not_true_eq_false, if_false]
        exact ih2 Γ ss hs hk hsc.2 hb h
      · simp only [hw, ne_eq, not_false_eq_true, if_true]
        exact ih1 Γ ss hs hk hsc.1 hb h
  | while_ e c ih =>
    intro Γ ss hs hk hsc hb h
    rw [liftProg, evaluate_hol_eqn_10, Pancake.PancakeSem, eval_agree ss hs h]
    cases he : Pancake.eval ss e with
    | none => exact ⟨trivial, h, fun hl => absurd hl id⟩
    | some w =>
      have hz : (0#64 : BitVec 64) = 0 := rfl
      simp only [Option.map_some, hz]
      by_cases hw : w = 0
      · simp only [hw, ne_eq, not_true_eq_false, if_false]
        exact ⟨trivial, h, fun _ => hb⟩
      · simp only [hw, ne_eq, not_false_eq_true, if_true, h.clock]
        by_cases hc : ss.clock = 0
        · simp only [hc, if_true]
          exact ⟨trivial, SR_empty h, fun hl => absurd hl id⟩
        · simp only [hc, if_false]
          obtain ⟨hr, hs1, hl1⟩ := ih Γ (Pancake.decClock ss) (dec_clock hs)
            (by simp [Pancake.decClock]; omega) hsc hb (SR_dec_clock h)
          have hfc := SR_fix_clock (SR_dec_clock h) hs1
          generalize hq : evaluate (liftProg c, dec_clock hs) = q at hr hs1 hfc
          generalize hrr : Pancake.PancakeSem (oracleOf ev) c (Pancake.decClock ss) = r at hr hs1 hl1 hfc
          obtain ⟨q1, q2⟩ := q
          obtain ⟨r1, r2⟩ := r
          simp only [Pancake.decClock] at hfc
          have hlt : (Pancake.clampClock (ss.clock - 1) (r1, r2)).2.clock ≤ k - 1 := by
            simp [Pancake.clampClock]; omega
          have hloop := ihk (k - 1) (by omega) (.while_ e c) Γ
            (Pancake.clampClock (ss.clock - 1) (r1, r2)).2 (fix_clock (dec_clock hs) (q1, q2)).2 hlt hsc
          simp only [fix_clock, Pancake.clampClock, dec_clock] at hfc hloop ⊢
          cases r1 with
          | none =>
            cases q1 with
            | none => exact hloop (hl1 trivial) hfc
            | some y => cases y <;> simp [RR] at hr
          | some x =>
            cases q1 with
            | none => cases x <;> simp [RR] at hr
            | some y =>
              cases x with
              | error =>
                cases y <;> simp [RR] at hr
                exact ⟨trivial, hfc, fun hl => absurd hl id⟩
              | timeout =>
                cases y <;> simp [RR] at hr
                exact ⟨trivial, hfc, fun hl => absurd hl id⟩
              | break_ =>
                cases y <;> simp [RR] at hr
                exact ⟨trivial, hfc, fun _ => hl1 trivial⟩
              | continue_ =>
                cases y <;> simp [RR] at hr
                exact hloop (hl1 trivial) hfc
              | return_ w' =>
                cases y <;> simp [RR] at hr
                rename_i v6
                rcases v6 with ⟨⟨w0⟩⟩ | _ | _ <;> simp [RR] at hr
                exact ⟨hr, hfc, fun hl => absurd hl id⟩
              | finalFFI e' =>
                cases y <;> simp [RR] at hr
                exact ⟨hr, hfc, fun hl => absurd hl id⟩
  | ret e =>
    intro Γ ss hs _ _ hb h
    rw [liftProg, evaluate_hol_eqn_11, Pancake.PancakeSem, eval_agree ss hs h]
    cases he : Pancake.eval ss e with
    | none => exact ⟨trivial, h, fun hl => absurd hl id⟩
    | some w =>
      simp only [Option.map_some, shape_of, size_of_sh_with_ctxt]
      exact ⟨rfl, SR_empty h, fun hl => absurd hl id⟩
  | storeByte d src =>
    intro Γ ss hs _ _ hb h
    rw [liftProg, evaluate_hol_eqn_5, Pancake.PancakeSem, eval_agree ss hs h, eval_agree ss hs h]
    cases hd : Pancake.eval ss d <;> cases hv : Pancake.eval ss src
    all_goals try exact ⟨trivial, h, fun hl => absurd hl id⟩
    rename_i a w
    have hm := mem_store_byte_agree ss.memory ss.memaddrs ss.be a (w.setWidth 8)
    unfold liftMem liftDom at hm
    simp only [Option.map_some, h.memory, h.memaddrs, h.be, hm]
    cases Pancake.memStoreByte ss.memory ss.memaddrs ss.be a (w.setWidth 8) with
    | none => exact ⟨trivial, h, fun hl => absurd hl id⟩
    | some m' =>
      exact ⟨trivial, ⟨h.locals, rfl, by simp [h.memaddrs], by simp [h.be], h.clock, h.ffi, h.base⟩,
        fun _ => hb⟩

/-! ## 8. Transfer form, and the hypotheses inhabited -/

/-- What the orb's proofs need: a Sem.lean run that returns `w` (or ends in a
final FFI event, or completes) is a panSem run with the same outcome. -/
theorem transfer_return (ev : final_event → Pancake.FinalEvent) (p : Pancake.PancakeProg)
    (ss : Pancake.PancakeState (ffi_state θ)) (hs : state θ) (hsc : Scoped [] p) (h : SR ss hs)
    (w : BitVec 64) (hw : (Pancake.PancakeSem (oracleOf ev) p ss).1 = some (.return_ w)) :
    (evaluate (liftProg p, hs)).1 = some (.Return (VW w)) := by
  have hr := (evaluate_agree ev ss.clock p [] ss hs (Nat.le_refl _) hsc
    (fun _ hk => by simp at hk) h).1
  rw [hw] at hr
  generalize (evaluate (liftProg p, hs)).1 = q at hr
  rcases q with _ | ⟨_ | _ | _ | _ | ⟨⟨⟨w0⟩⟩ | _ | _⟩ | _ | _⟩ <;> simp_all [RR]

/-- A scoped program, a related pair of states, and the agreement at work:
both semantics return 7 (so no hypothesis of `evaluate_agree` is vacuous). -/
theorem agree_witness (ev : final_event → Pancake.FinalEvent) (f : ffi_state θ) :
    (Pancake.PancakeSem (oracleOf ev) (.dec "x" (.const 7) (.ret (.var "x"))) (ss0 f)).1 =
      some (.return_ 7) ∧
    (evaluate (liftProg (.dec "x" (.const 7) (.ret (.var "x"))), hs0 f)).1 = some (.Return (VW 7)) := by
  have hp : (Pancake.PancakeSem (oracleOf ev) (.dec "x" (.const 7) (.ret (.var "x"))) (ss0 f)).1 =
      some (.return_ 7) := by
    simp [Pancake.PancakeSem, Pancake.eval, Pancake.setLocal]
  exact ⟨hp, transfer_return ev _ _ _ (by simp [Scoped]) (ss0_hs0 f) 7 hp⟩

end P3.Agree

