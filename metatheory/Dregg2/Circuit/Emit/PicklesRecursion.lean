import Dregg2.Circuit.Emit.KimchiVerify

namespace Dregg2.Circuit.Emit.PicklesRecursion

open Dregg2.Circuit.Emit.PastaIPA
  (bEval sVec polyEval IpaDeferred absorbChallenges deferredMsmSize sVec_length sVec_eq_bPoly
   deferral_compression)
open Dregg2.Circuit.Emit.KimchiVerify
  (shapeOk shapeOkRec kimchiVerifyDecision kimchiVerifyDecisionRec kimchiVerifyDecisionField
   kimchiVerifyDecisionGates GateEvals gateLinConst genericGateConstraint endomulScalarConstsOk
   PERMUTS COLUMNS sqIter sqIter_eq)

set_option autoImplicit false
-- Kernel-heavy `decide`s below (255-step `2^255`, 45-entry eval folds over `ZMod pN`/`ZMod qN`).
set_option maxRecDepth 40000

/-! ## §P0.0 — the two sides of the Pasta 2-cycle, as DATA.

`Tick = Step`, `Tock = Wrap` (`backend/backend.ml:1-9`: `Tick = Vesta_based_plonk` with
`Inner_curve = Pallas`; `Tock = Pallas_based_plonk` with `Inner_curve = Vesta`). Round counts are
`kimchi_pasta_basic.ml:16-17` — `Rounds.Step = N16`, `Rounds.Wrap = N15` — and `Max_degree`
(`common.ml:6-13`) is `2^rounds` on each side. `prev_challenges` is the Kimchi `prev_challenges` the
side's verification key is GENERATED with: the Wrap key is always `2` ("Due to Wrap_hack",
`side_loaded_verification_key.ml:236`, `compile.ml:714`, `pickles.ml:1349`); a Step key takes the
branch's `proofs_verified` (`compile.ml:637`). -/

/-- A side of the cycle. -/
inductive Side where
  | step | wrap
  deriving DecidableEq, Repr

/-- One of the two Pasta curves. -/
inductive PastaName where
  | pallas | vesta
  deriving DecidableEq, Repr

/-- **`SideShape`** — everything a Kimchi verifier must know to be instantiated at ONE side of the
cycle. `scalarModulus` is the field the proof's evaluations/challenges live in (the commitment
curve's SCALAR field); `circuitCurve` is the curve the verifier CIRCUIT does point ops on (the
curve whose BASE field is the circuit's native field). -/
structure SideShape where
  side : Side
  /-- the Kimchi proof's scalar field modulus (`Vesta::ScalarField = pN` / `Pallas::ScalarField = qN`) -/
  scalarModulus : Nat
  /-- the curve the proof's polynomial commitments live on -/
  commitCurve : PastaName
  /-- the curve the verifier circuit does in-circuit group ops on -/
  circuitCurve : PastaName
  /-- IPA rounds `k = log₂ max_poly_size` (`kimchi_pasta_basic.ml:16-17`) -/
  rounds : Nat
  /-- the `prev_challenges` the side's VK is generated with -/
  prevChallenges : Nat
  deriving DecidableEq, Repr

/-- **The Step side** (tick): Fp scalars, Vesta-committed proof, Pallas point ops in-circuit,
`k = 16`. `prevChallenges` is the branch's `proofs_verified` (`compile.ml:637`), so it is a
PARAMETER, not a constant — `stepShape 0` is exactly K5/`KimchiRealProofGate`'s object. -/
def stepShape (proofsVerified : Nat) : SideShape :=
  { side := .step
    scalarModulus := Dregg2.Circuit.Emit.PastaField.pN
    commitCurve := .vesta
    circuitCurve := .pallas
    rounds := 16
    prevChallenges := proofsVerified }

/-- **The Wrap side** (tock): Fq scalars, Pallas-committed proof, Vesta point ops in-circuit,
`k = 15`, `prev_challenges = 2` ALWAYS (Wrap_hack). This is the object a node actually verifies
when it verifies a Mina block (`verify.ml:132,206,210`). -/
def wrapShape : SideShape :=
  { side := .wrap
    scalarModulus := Dregg2.Circuit.Emit.PastaField.qN
    commitCurve := .pallas
    circuitCurve := .vesta
    rounds := 15
    prevChallenges := 2 }

/-- **`sides_discriminate`** — the two shapes differ in EVERY field that a verifier instantiation
depends on: the scalar field, the commitment curve, the in-circuit curve, and the round count. A
Wrap verify is NOT a Step verify with different numbers pasted in. -/
theorem sides_discriminate :
    (stepShape 0).scalarModulus ≠ wrapShape.scalarModulus
    ∧ (stepShape 0).commitCurve ≠ wrapShape.commitCurve
    ∧ (stepShape 0).circuitCurve ≠ wrapShape.circuitCurve
    ∧ (stepShape 0).rounds ≠ wrapShape.rounds
    ∧ stepShape 0 ≠ wrapShape ∧ stepShape 1 ≠ wrapShape ∧ stepShape 2 ≠ wrapShape := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-- **`cycle_is_a_swap`** — the cycle is a genuine SWAP: each side commits on the curve the other
side does point ops on, and each side's scalar field is the other side's point-coordinate field.
This is why the deferred scalar arithmetic of §P2 is native to the OTHER circuit. -/
theorem cycle_is_a_swap :
    (stepShape 0).commitCurve = wrapShape.circuitCurve
    ∧ wrapShape.commitCurve = (stepShape 0).circuitCurve := by
  refine ⟨?_, ?_⟩ <;> decide

/-- **`maxDegreeLog2`** — `Max_degree.{step,wrap}` (`common.ml:6-13`) = `2^rounds`. -/
def maxDegree (sh : SideShape) : Nat := 2 ^ sh.rounds

/-- Step's max degree is `2^16 = 65536`; Wrap's is `2^15 = 32768` (`common.ml:6-13`). -/
theorem maxDegree_pins : maxDegree (stepShape 0) = 65536 ∧ maxDegree wrapShape = 32768 := by
  refine ⟨?_, ?_⟩ <;> decide

/-- **`wrapDomainLog2`** — the wrap evaluation domain is keyed by `proofs_verified`
(`common.ml:27-31`): `0 ↦ 2^13, 1 ↦ 2^14, 2 ↦ 2^15`. (Domain SELECTION as a verifier gate is P8;
the table is pinned here because §P2's `branch_data` carries `domain_log2`.) -/
def wrapDomainLog2 : Nat → Nat
  | 0 => 13
  | 1 => 14
  | 2 => 15
  | _ => 0

/-- **`actualWrapDomainSize`** — the inverse table (`common.ml:33-45`). -/
def actualWrapDomainSize : Nat → Nat
  | 13 => 0
  | 14 => 1
  | 15 => 2
  | _ => 0

/-- The two tables are mutually inverse on the legal range `proofs_verified ∈ {0,1,2}`, and the
largest wrap domain equals Wrap's `max_poly_size` exponent. -/
theorem wrapDomain_roundtrip :
    (∀ pv ∈ [0, 1, 2], actualWrapDomainSize (wrapDomainLog2 pv) = pv)
    ∧ wrapDomainLog2 2 = wrapShape.rounds := by
  refine ⟨?_, ?_⟩ <;> decide

/-! ## §P0.1 — cheap high powers: `sqIter` (so a `2^15`-order anchor costs 15 multiplications).

`x ^ 2^k` is `npowRec`-linear in the kernel, so the real wrap domain generator (order `2^15`)
cannot be anchored by `decide`-ing `ω ^ 32768`. `sqIter` is the repeated-squaring ladder, TIED to
the power by `sqIter_eq`, so the anchor below is a real theorem about `ω ^ 2^15` that the kernel
checks in 15 multiplications.

⚑ The ladder MOVED to `KimchiVerify` §7b on 2026-07-28 and is `open`ed above — the C8 recursion
fold (`bEvalSq`, the `b_poly` squaring ladder of `commitment.rs:429-433`) needs it upstream, and
this file's copy would have been the second one. Same definition, same proof; no local re-statement
is kept "for readability". -/

/-! ## §P0.2 — the Wrap scalar field `Fq = ZMod qN`, and the REAL wrap domain generators.

The Wrap Kimchi proof is Pallas-committed, so its scalars are `Pallas::ScalarField = Fq = ZMod qN`
(`PastaField.qN`, mina-curves `fq.rs`) — the OTHER field from K5's Step instantiation. Arkworks
sets `TWO_ADIC_ROOT_OF_UNITY = GENERATOR^{(q-1)/2^32}` with `TWO_ADICITY = 32`, `GENERATOR = 5`
(`curves/src/pasta/fields/fq.rs:8-24`); the evaluation-domain generator for `2^k` is that root
raised to `2^(32-k)`. The three wrap domains are `2^13/2^14/2^15` (`common.ml:27-31`). -/

/-- The Wrap scalar field: `Fq = Pallas::ScalarField = ZMod qN`. -/
abbrev Fq := ZMod Dregg2.Circuit.Emit.PastaField.qN

/-- The Step scalar field (K5's instantiation): `Fp = Vesta::ScalarField = ZMod pN`. -/
abbrev Fp := ZMod Dregg2.Circuit.Emit.PastaField.pN

